# Plugin: fastfetch
# Description: Show a fastfetch system-info banner when opening an interactive shell
# Author: Abdullah Masood
# Version: 1.0.0
# Dependencies: None
# Requires: fastfetch|Fastfetch-cli.Fastfetch
# Startup Cost: ~15ms

# Only draw the banner in an interactive session so scripts, `pwsh -Command`,
# and `pwsh -File` stay fast. Treat the session as interactive when it was
# launched with -NoExit, or when none of the non-interactive switches
# (-Command/-c/-File/-f/-NonInteractive) appear on the command line.
$__ffArgs  = [Environment]::GetCommandLineArgs()
$__ffFlags = @('-Command', '-c', '-File', '-f', '-NonInteractive', '-noni')
$__ffInteractive = ($__ffArgs -contains '-NoExit') -or -not (
    $__ffArgs | Where-Object { $__ffFlags -contains $_ }
)

if ($__ffInteractive -and (Get-Command fastfetch -ErrorAction SilentlyContinue)) {
    fastfetch
}

Remove-Variable __ffArgs, __ffFlags, __ffInteractive -ErrorAction SilentlyContinue
