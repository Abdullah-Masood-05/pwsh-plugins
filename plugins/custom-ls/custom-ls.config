# Plugin: custom-ls
# Description: Colorized ls that wraps Get-ChildItem using ANSI colors, no modules
# Author: Abdullah Masood
# Version: 1.0.0
# Dependencies: None
# Requires: None
# Startup Cost: ~0ms

# ANSI color per category. 16-color SGR codes render in any ANSI-capable
# terminal (Windows Terminal, VS Code, etc.). `e is PowerShell 7's escape char.
$script:LsColors = @{
    Directory  = "`e[1;34m"   # bold blue
    Archive    = "`e[1;31m"   # bold red
    Image      = "`e[1;35m"   # bold magenta
    Code       = "`e[1;33m"   # bold yellow
    Document   = "`e[1;36m"   # bold cyan
    Executable = "`e[1;32m"   # bold green
    Default    = "`e[0m"      # terminal default
}

# Extension -> category map (lower-case keys).
$script:LsExtensions = @{
    '.zip' = 'Archive'; '.7z' = 'Archive'; '.gz' = 'Archive'; '.tar' = 'Archive'
    '.rar' = 'Archive'; '.xz' = 'Archive'; '.bz2' = 'Archive'
    '.png' = 'Image'; '.jpg' = 'Image'; '.jpeg' = 'Image'; '.gif' = 'Image'
    '.bmp' = 'Image'; '.svg' = 'Image'; '.ico' = 'Image'; '.webp' = 'Image'
    '.ps1' = 'Code'; '.psm1' = 'Code'; '.psd1' = 'Code'; '.py' = 'Code'
    '.js' = 'Code'; '.ts' = 'Code'; '.c' = 'Code'; '.cpp' = 'Code'; '.h' = 'Code'
    '.cs' = 'Code'; '.go' = 'Code'; '.rs' = 'Code'; '.rb' = 'Code'; '.java' = 'Code'
    '.html' = 'Code'; '.css' = 'Code'; '.json' = 'Code'; '.xml' = 'Code'; '.yml' = 'Code'
    '.yaml' = 'Code'; '.sh' = 'Code'
    '.md' = 'Document'; '.txt' = 'Document'; '.pdf' = 'Document'; '.doc' = 'Document'
    '.docx' = 'Document'; '.xls' = 'Document'; '.xlsx' = 'Document'; '.csv' = 'Document'
    '.ppt' = 'Document'; '.pptx' = 'Document'; '.rtf' = 'Document'
    '.exe' = 'Executable'; '.msi' = 'Executable'; '.bat' = 'Executable'; '.cmd' = 'Executable'
}

# Colorized directory listing. All arguments are forwarded to Get-ChildItem,
# so `ls`, `ls -Force`, `ls C:\ -Filter *.ps1`, etc. all work.
function ls {
    $items = Get-ChildItem @args
    if (-not $items) { return }

    # When the stream is redirected (piping to a command or a file), emit the
    # raw objects so `ls | Where-Object ...` and captures keep working.
    if ([Console]::IsOutputRedirected) { return $items }

    $reset = "`e[0m"
    foreach ($item in $items) {
        $key = 'Default'
        if ($item.PSIsContainer) {
            $key = 'Directory'
        }
        elseif ($item.Extension) {
            $ext = $item.Extension.ToLower()
            if ($script:LsExtensions.ContainsKey($ext)) {
                $key = $script:LsExtensions[$ext]
            }
        }
        Write-Host "$($script:LsColors[$key])$($item.Name)$reset"
    }
}

# Short alias.
function l { ls @args }
