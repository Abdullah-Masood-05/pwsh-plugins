# Plugin: psreadline-bindings
# Description: Zsh-like PSReadLine key bindings for faster interactive editing
# Author: Abdullah Masood
# Version: 1.0.0
# Dependencies: None
# Requires: None
# Startup Cost: ~0ms

# Key bindings only matter in an interactive session; skip all of this for
# scripts and `pwsh -Command` so non-interactive startup pays nothing.
$__prlArgs  = [Environment]::GetCommandLineArgs()
$__prlFlags = @('-Command', '-c', '-File', '-f', '-NonInteractive', '-noni')
$__prlInteractive = ($__prlArgs -contains '-NoExit') -or -not (
    $__prlArgs | Where-Object { $__prlFlags -contains $_ }
)

if ($__prlInteractive) {
    try {
        Import-Module PSReadLine -ErrorAction SilentlyContinue
        if (Get-Module PSReadLine) {
            # Undo, like most editors and zsh's `Ctrl+_`.
            Set-PSReadLineKeyHandler -Chord 'Ctrl+z'         -Function Undo
            # Word-wise cursor movement. The parent profile already binds
            # Ctrl+Left/Right, so use Alt here to complement rather than clash.
            Set-PSReadLineKeyHandler -Chord 'Alt+LeftArrow'  -Function BackwardWord
            Set-PSReadLineKeyHandler -Chord 'Alt+RightArrow' -Function ForwardWord
            # Word-wise deletion.
            Set-PSReadLineKeyHandler -Chord 'Ctrl+Backspace' -Function BackwardDeleteWord
            Set-PSReadLineKeyHandler -Chord 'Ctrl+Delete'    -Function DeleteWord
        }
    }
    catch {
        # PSReadLine not available (e.g. a minimal host); ignore and continue.
    }
}

Remove-Variable __prlArgs, __prlFlags, __prlInteractive -ErrorAction SilentlyContinue
