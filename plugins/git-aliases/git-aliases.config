# Plugin: git-aliases
# Description: Short Git shortcut functions for the most common commands
# Author: Abdullah Masood
# Version: 1.0.0
# Dependencies: None
# Requires: git|Git.Git
# Startup Cost: ~0ms

# Each function forwards its arguments to git with @args splatting, so any
# extra flags you pass are handed straight through (e.g. `gco -f main`).

# git checkout <branch|path>
function gco { git checkout @args }

# git checkout -b <new-branch>  (create and switch)
function gcb { git checkout -b @args }

# git commit -m "<message>"
function gcm { git commit -m @args }

# git commit -am "<message>"  (stage tracked changes, then commit)
function gca { git commit -am @args }

# git add -A  (stage everything: new, modified, and deleted)
function gaa { git add -A @args }

# git status
function gst { git status @args }

# git pull
function gpl { git pull @args }

# git push
function gps { git push @args }

# git diff
function gd { git diff @args }

# git log as a decorated one-line graph
function gl { git log --oneline --graph --decorate @args }
