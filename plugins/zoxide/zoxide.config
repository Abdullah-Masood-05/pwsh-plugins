# Plugin: zoxide
# Description: Smart directory jumping with the z command, powered by zoxide
# Author: Abdullah Masood
# Version: 1.0.0
# Dependencies: None
# Requires: zoxide|ajeetdsouza.zoxide
# Startup Cost: ~5ms

# Initialize zoxide only when the binary is on PATH, so the profile stays clean
# (and this snippet is a no-op) on machines where zoxide is not installed yet.
if (Get-Command zoxide -ErrorAction SilentlyContinue) {
    Invoke-Expression (& { (zoxide init powershell | Out-String) })
}
